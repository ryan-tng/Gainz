{
  "expo": {
    "name": "Gainz",
    "slug": "gainz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gainz",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#08090b",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.ryantng.gainz",
      "supportsTablet": true
    },
    "android": {
      "package": "com.ryantng.gainz",
      "adaptiveIcon": {
        "backgroundColor": "#08090b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08090b",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Gainz uses your photos to add pictures and tutorials to gym machines.",
          "cameraPermission": "Gainz uses your camera to take photos of gym machines and their instructions."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Gainz uses your camera to scan food barcodes."
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d244be79-a022-403e-8a84-006d0be86276"
      }
    },
    "owner": "ryantng"
  }
}
